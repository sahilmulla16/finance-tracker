<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Android 12+ (API 31+) Data Extraction Rules -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local SQLite databases holding unencrypted financial transactions, accounts, and nominee PII from automated Google Drive cloud backup -->
        <exclude domain="database" path="RKStorage" />
        <exclude domain="database" path="RKStorage-journal" />
        <exclude domain="database" path="RKStorage-wal" />
        <exclude domain="database" path="RKStorage-shm" />
        <exclude domain="database" path="AsyncStorage" />
        <exclude domain="database" path="AsyncStorage-journal" />
        <exclude domain="database" path="AsyncStorage-wal" />
        <exclude domain="database" path="AsyncStorage-shm" />

        <!-- Exclude authentication tokens and secrets -->
        <exclude domain="sharedpref" path="PocketflowAuth.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- Exclude auth tokens from device-to-device cable transfers to force re-authentication -->
        <exclude domain="sharedpref" path="PocketflowAuth.xml" />
    </device-transfer>
</data-extraction-rules>
