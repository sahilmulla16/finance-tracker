<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/ios_sheet_bg"
    android:clickable="true"
    android:focusable="true"
    android:elevation="12dp">

    <!-- Header Label -->
    <TextView
        android:id="@+id/stepLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Amount"
        android:textSize="13sp"
        android:textColor="#6C6C70"
        android:textStyle="normal"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="10dp" />

    <!-- Amount Input Box -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:background="@drawable/ios_input_bg">

        <TextView
            android:id="@+id/currencySymbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#8E8E93"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/amountInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="0"
            android:inputType="numberDecimal"
            android:importantForAutofill="no"
            android:textSize="24sp"
            android:textColor="#000000"
            android:textColorHint="#C7C7CC"
            android:background="@null"
            android:padding="0dp"
            android:singleLine="true"
            android:imeOptions="actionNext" />

        <TextView
            android:id="@+id/amountClearBtn"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/ios_clear_btn_bg"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Error message (hidden by default) -->
    <TextView
        android:id="@+id/amountError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF3B30"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cancel"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="@drawable/ios_btn_cancel_bg"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/doneButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Done"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/ios_btn_done_bg"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
