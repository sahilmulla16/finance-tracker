<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:background="@drawable/ios_sheet_bg"
    android:clickable="true"
    android:focusable="true"
    android:elevation="12dp">

    <!-- Header Label -->
    <TextView
        android:id="@+id/stepLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category"
        android:textSize="13sp"
        android:textColor="#6C6C70"
        android:textStyle="normal"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="12dp" />

    <!-- Top Hairline Divider -->
    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#D1D1D6" />

    <!-- Category List ScrollView -->
    <!-- Category List ScrollView (caps at 6 items with smooth vertical scrolling slider) -->
    <ScrollView
        android:id="@+id/categoryScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <LinearLayout
            android:id="@+id/categoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Loading indicator -->
    <TextView
        android:id="@+id/loadingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:textSize="14sp"
        android:textColor="#8E8E93"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <!-- Error message -->
    <TextView
        android:id="@+id/categoryError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF3B30"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

</LinearLayout>
